# npm start/dev loads .env when present. Keep real credentials out of version control.
# Legacy manual configuration. For automatic web installation use the root .env.example instead.
YUMUNIO_WEB_SETUP=false
# Self-host DB choices: mariadb, tidb (MySQL-compatible), mysql, postgres; no preferred DB.
# browser-local and sqlite remain available. The mariadb value below is an example selection.
# Workers uses its separate D1 binding/configuration, not this Node database URL.
YUMUNIO_STORAGE=mariadb
YUMUNIO_HOST=127.0.0.1
YUMUNIO_PORT=8788
YUMUNIO_PUBLIC_ORIGIN=http://127.0.0.1:8788
# Generate a random value locally; 32 to 4096 characters. External SQL always requires it.
YUMUNIO_ACCESS_KEY=

# Percent-encode reserved characters in URL credentials.
# MariaDB / MySQL example: mysql://yumunio:<encoded-password>@database.example.invalid:3306/yumunio
# TiDB example: YUMUNIO_STORAGE=tidb and mysql://yumunio:<encoded-password>@tidb.example.invalid:4000/yumunio
# Use the actual endpoint and port for your TiDB deployment; this is not a verified connection.
# PostgreSQL: postgres://yumunio:<encoded-password>@127.0.0.1:5432/yumunio
# Compose overrides: use host "database", port 3306 (MariaDB) or 5432 (PostgreSQL).
YUMUNIO_DATABASE_URL=
# Bundled Compose databases use a private bridge without TLS: explicitly set disable for that profile.
# verify-full checks the certificate and server name (MySQL requires a DNS host, not an IP). Use disable only for a trusted local network.
YUMUNIO_DATABASE_TLS=verify-full
# Optional inline PEM CA certificate. Dotenv accepts a quoted multiline value.
YUMUNIO_DATABASE_CA=

# Only used by YUMUNIO_STORAGE=sqlite:
YUMUNIO_DATABASE=.data/yumunio.sqlite

# Only used by the MariaDB/PostgreSQL Compose examples, to create the database user.
# Must match the decoded password in YUMUNIO_DATABASE_URL.
YUMUNIO_DB_PASSWORD=

# PostgreSQL Compose only: separate administrator password; the app uses a non-superuser role.
YUMUNIO_DB_ADMIN_PASSWORD=

# Accounts are separate from the legacy snapshot access key and are disabled by default.
# Configure accounts as enabled, run npm run auth:migrate explicitly, then start the server.
YUMUNIO_ACCOUNTS_ENABLED=false
# Separate random secret, 32 to 4096 characters; never reuse YUMUNIO_ACCESS_KEY.
YUMUNIO_AUTH_SECRET=
# closed or open. Open registration requires a configured mail adapter.
YUMUNIO_REGISTRATION_MODE=closed
# unrestricted adds no allowlist restriction; blocked domains still win.
# allowlist requires a nonempty comma-separated YUMUNIO_EMAIL_ALLOWED_DOMAINS.
YUMUNIO_EMAIL_DOMAIN_MODE=unrestricted
YUMUNIO_EMAIL_ALLOWED_DOMAINS=
YUMUNIO_EMAIL_BLOCKED_DOMAINS=
YUMUNIO_EMAIL_ALLOW_SUBDOMAINS=false
YUMUNIO_EMAIL_BLOCK_SUBDOMAINS=true

# Mail: disabled, smtp, http, or cloudflare (Workers EMAIL sending binding).
# On Cloudflare Workers configure either cloudflare (EMAIL binding) or smtp (Cloudflare SMTP is also SMTP).

# Web setup includes guided configuration; see docs/mail-setup.md.
# Public signup/resend/reset responses acknowledge requests, never delivery.
YUMUNIO_MAIL_DRIVER=disabled
# Bare sender and optional reply address, shared by all enabled drivers.
YUMUNIO_SMTP_FROM=
YUMUNIO_SMTP_REPLY_TO=
# SMTP requires TLS and certificate/name verification; no plaintext fallback.
# Workers cannot use port 25 or destinations restricted by Cloudflare.
YUMUNIO_SMTP_HOST=
YUMUNIO_SMTP_PORT=587
# starttls_required (normally 587) or implicit_tls (normally 465; change PORT too).
YUMUNIO_SMTP_TLS=starttls_required
# Leave both empty for a relay without authentication, otherwise supply both.
YUMUNIO_SMTP_USER=
YUMUNIO_SMTP_PASSWORD=
# Fixed JSON relay endpoint, HTTPS only, no query/fragment or redirect following.
YUMUNIO_MAIL_HTTP_ENDPOINT=
YUMUNIO_MAIL_HTTP_TOKEN=

# Optional external login/signup. Both values are required; leave both empty to hide the provider.
# No external OAuth clients are created or validated by this example.
# Register PUBLIC_ORIGIN + /api/auth/callback/{google|github|discord|oidc} with each provider.
YUMUNIO_OAUTH_GOOGLE_CLIENT_ID=
YUMUNIO_OAUTH_GOOGLE_CLIENT_SECRET=
YUMUNIO_OAUTH_GITHUB_CLIENT_ID=
YUMUNIO_OAUTH_GITHUB_CLIENT_SECRET=
YUMUNIO_OAUTH_DISCORD_CLIENT_ID=
YUMUNIO_OAUTH_DISCORD_CLIENT_SECRET=
# Generic OIDC uses HTTPS issuer discovery, PKCE S256 and signed ID tokens (RS256/PS256/ES256).
# Enable explicitly and supply issuer plus both credentials. Identity issuer changes are not account merges.
YUMUNIO_OIDC_ENABLED=false
YUMUNIO_OIDC_DISPLAY_NAME="組織のSSO"
YUMUNIO_OIDC_ISSUER=
YUMUNIO_OIDC_CLIENT_ID=
YUMUNIO_OIDC_CLIENT_SECRET=
# Registration/domain rules apply to external identities. Matching email alone never links accounts.
# Explicit account linking and provider-initiated logout are not exposed in this phase.

# Private attachment storage, independent of the SQL database. Never place a public bucket URL here.
# disabled (default), local (Node), s3 (Node/Workers), r2 (Workers binding).
YUMUNIO_BLOB_DRIVER=disabled
YUMUNIO_BLOB_LOCAL_DIR=.data/blobs
# Exact HTTPS S3 API origin, without a path or trailing slash. Wasabi and other compatible providers use their own region.
YUMUNIO_S3_ENDPOINT=
YUMUNIO_S3_REGION=
YUMUNIO_S3_BUCKET=
# Required application-owned nonempty prefix ending in slash; ASCII letters/digits/_/- and nested folders only.
YUMUNIO_S3_PREFIX=yumunio/
YUMUNIO_S3_FORCE_PATH_STYLE=true
YUMUNIO_S3_ACCESS_KEY_ID=
YUMUNIO_S3_SECRET_ACCESS_KEY=
YUMUNIO_S3_SESSION_TOKEN=
# Bind this private R2 bucket in Wrangler; the name alone does not create a bucket.
YUMUNIO_R2_BINDING=BLOBS

# Public instance branding. Invalid fields use safe defaults; no browser write API.
# Files are deployed separately under apps/web/public/brand/ (SVG/PNG/ICO only).
# Use a same-origin /brand/... path, never an external URL, query, fragment or private endpoint.
YUMUNIO_BRAND_NAME=Yumunio
YUMUNIO_BRAND_ORGANIZATION=
YUMUNIO_BRAND_LOGO_LIGHT=
YUMUNIO_BRAND_LOGO_DARK=
YUMUNIO_BRAND_FAVICON=
YUMUNIO_BRAND_COLOR="#385772"
# Optional installable-app PNG icons, deployed under /brand/. Supply exactly these pixel sizes.
YUMUNIO_BRAND_PWA_ICON_192=
YUMUNIO_BRAND_PWA_ICON_512=
# Newly saved local preference profiles only; existing personal themes/colors/locales are preserved.
# paper | light | ocean | lavender | forest | midnight; available UI locales: ja | en.
YUMUNIO_DEFAULT_THEME=light
YUMUNIO_DEFAULT_LOCALE=ja
# Server administrators: existing verified account IDs, comma-separated. No automatic first-account promotion.
YUMUNIO_SERVER_ADMIN_IDS=

# Optional page-scoped bearer API. Apply account/token scope migrations explicitly before enabling.
# Tokens require a verified account, one reviewed page, expiry and current live page permission.
# Reading, supported text-block editing and MCP connection are separate explicit token permissions.
YUMUNIO_API_TOKENS_ENABLED=false
# Optional stateless Streamable HTTP MCP endpoint at /api/mcp; requires accounts and API tokens.
# Clients send a personal token with mcp:connect in Authorization. No model calls are made.
YUMUNIO_MCP_ENABLED=false

# Optional metadata-only webhooks. Disabled until operator configuration AND admin/page approval.
YUMUNIO_WEBHOOK_ENABLED=false
YUMUNIO_WEBHOOK_ENDPOINT=
# Dedicated canonical base64-encoded 32-byte HMAC key; never enter it in the browser.
YUMUNIO_WEBHOOK_SIGNING_KEY=
YUMUNIO_WEBHOOK_LABEL=Webhook
YUMUNIO_WEBHOOK_EVENTS=page.updated
# Optional canonical subset: page.updated,page.title.updated,page.document.updated,page.created,page.moved,page.trashed,page.restored.
# Explicitly include currently manageable descendants; changes the reviewed destination profile.
YUMUNIO_WEBHOOK_INCLUDE_DESCENDANTS=false
# Changing this list changes the approved profile and requires approval again; upgrade schema first.

# Full-instance encrypted backup: opt in only after applying `npm run backup:migrate`.
# SQL accounts/pages/ACL + committed/private ready file bytes; excludes env secrets and unknown extension tables.
# disabled (default), local (Node), s3 (Node/Workers), r2 (Workers private binding).
YUMUNIO_BACKUP_DRIVER=disabled
# Independent, canonical base64 of exactly 32 random bytes. Keep offline, separately from the archive.
# Keep the source YUMUNIO_AUTH_SECRET separately too; encrypted account/OAuth data needs it for recovery.
YUMUNIO_BACKUP_ENCRYPTION_KEY=
# Empty = manual only. Daily UTC schedule, e.g. "0 3 * * *". Node timer / Workers Cron invokes the runner.
YUMUNIO_BACKUP_SCHEDULE=
# Retention remains display-only until cleanup opt-in AND explicit administrator approval.
YUMUNIO_BACKUP_RETENTION_DAYS=30
# Apply backup:migrate (D1 migration 0005), stop old runtimes/restores, then review the dedicated destination.
# Only recorded app artifacts are eligible. Keep a verified latest archive; never force-take archive gates.
YUMUNIO_BACKUP_CLEANUP_ENABLED=false
YUMUNIO_BACKUP_CLEANUP_FAILED_GRACE_DAYS=7
YUMUNIO_BACKUP_LOCAL_DIR=.data/backups
# Dedicated private backup credentials: never inherited from the active attachment configuration.
YUMUNIO_BACKUP_S3_ENDPOINT=
YUMUNIO_BACKUP_S3_REGION=
YUMUNIO_BACKUP_S3_BUCKET=
YUMUNIO_BACKUP_S3_PREFIX=yumunio-backups/
YUMUNIO_BACKUP_S3_FORCE_PATH_STYLE=true
YUMUNIO_BACKUP_S3_ACCESS_KEY_ID=
YUMUNIO_BACKUP_S3_SECRET_ACCESS_KEY=
YUMUNIO_BACKUP_S3_SESSION_TOKEN=
YUMUNIO_BACKUP_R2_BINDING=BACKUPS
