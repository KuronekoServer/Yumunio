{
  "name": "yumunio",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node packages/tooling/build-web.mjs",
    "cwd": "../..",
    "watch_dir": [
      "../web/public",
      "../../packages/prototype/src"
    ]
  },
  "assets": {
    "directory": "../../.build/web",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index",
      "/index.html",
      "/account",
      "/account/",
      "/account.html",
      "/admin",
      "/admin/",
      "/admin.html",
      "/attachments",
      "/attachments/",
      "/attachments.html",
      "/backlinks",
      "/backlinks/",
      "/backlinks.html",
      "/backups",
      "/backups/",
      "/backups.html",
      "/collections",
      "/collections/",
      "/collections.html",
      "/comments",
      "/comments/",
      "/comments.html",
      "/forms",
      "/forms/",
      "/forms.html",
      "/history",
      "/history/",
      "/history.html",
      "/import",
      "/import/",
      "/import.html",
      "/install",
      "/install/",
      "/install.html",
      "/integrations",
      "/integrations/",
      "/integrations.html",
      "/notes",
      "/notes/",
      "/notes.html",
      "/offline",
      "/offline/",
      "/offline.html",
      "/preferences",
      "/preferences/",
      "/preferences.html",
      "/publication",
      "/publication/",
      "/publication.html",
      "/setup",
      "/setup/",
      "/setup.html",
      "/share",
      "/share/",
      "/share.html",
      "/site",
      "/site/",
      "/site.html",
      "/templates",
      "/templates/",
      "/templates.html",
      "/webhooks",
      "/webhooks/",
      "/webhooks.html",
      "/workspace-settings",
      "/workspace-settings/",
      "/workspace-settings.html",
      "/workspace",
      "/workspace/",
      "/workspace.html",
      "/api",
      "/api/*",
      "/health",
      "/manifest.webmanifest"
    ]
  },
  "vars": {
    "YUMUNIO_PUBLIC_ORIGIN": "https://workspace.example.invalid",
    "YUMUNIO_BLOB_DRIVER": "r2",
    "YUMUNIO_R2_BINDING": "BLOBS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yumunio",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "REPLACE_WITH_YOUR_PRIVATE_BUCKET"
    }
  ],
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  }
}
