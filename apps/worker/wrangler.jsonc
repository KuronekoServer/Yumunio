{
  "name": "yumunio-prototype",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node packages/tooling/build-web.mjs",
    "cwd": "../..",
    "watch_dir": [
      "../web/public",
      "../../packages/prototype/src"
    ]
  },
  "assets": {
    "directory": "../../.build/web",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*",
      "/health",
      "/manifest.webmanifest"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
