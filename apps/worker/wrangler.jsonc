{
  "name": "yumunio-prototype",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PageRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PageRoom"] }],
  "build": {
    "command": "node packages/tooling/build-web.mjs",
    "cwd": "../..",
    "watch_dir": [
      "../web/public",
      "../../packages/prototype/src"
    ]
  },
  "assets": {
    "directory": "../../.build/web",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index",
      "/index.html",
      "/account",
      "/account/",
      "/account.html",
      "/admin",
      "/admin/",
      "/admin.html",
      "/attachments",
      "/attachments/",
      "/attachments.html",
      "/backlinks",
      "/backlinks/",
      "/backlinks.html",
      "/backups",
      "/backups/",
      "/backups.html",
      "/collections",
      "/collections/",
      "/collections.html",
      "/comments",
      "/comments/",
      "/comments.html",
      "/forms",
      "/forms/",
      "/forms.html",
      "/history",
      "/history/",
      "/history.html",
      "/import",
      "/import/",
      "/import.html",
      "/install",
      "/install/",
      "/install.html",
      "/integrations",
      "/integrations/",
      "/integrations.html",
      "/notes",
      "/notes/",
      "/notes.html",
      "/offline",
      "/offline/",
      "/offline.html",
      "/preferences",
      "/preferences/",
      "/preferences.html",
      "/publication",
      "/publication/",
      "/publication.html",
      "/setup",
      "/setup/",
      "/setup.html",
      "/share",
      "/share/",
      "/share.html",
      "/site",
      "/site/",
      "/site.html",
      "/templates",
      "/templates/",
      "/templates.html",
      "/webhooks",
      "/webhooks/",
      "/webhooks.html",
      "/workspace-settings",
      "/workspace-settings/",
      "/workspace-settings.html",
      "/workspace",
      "/workspace/",
      "/workspace.html",
      "/api",
      "/api/*",
      "/health",
      "/manifest.webmanifest"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
