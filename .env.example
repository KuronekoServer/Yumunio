# Copy to .env. Initial installation is completed in your browser.
# New installations are prepared automatically by npm start and Docker Compose.
# Existing manual deployments can opt out:
# YUMUNIO_WEB_SETUP=false

# For public hosting, set your exact HTTPS URL before the first start.
# YUMUNIO_PUBLIC_ORIGIN=https://notes.example.com

# Docker creates and persists the necessary installation credentials automatically.
# Advanced database and storage options: deploy/advanced.env.example
# Optional image version:
# YUMUNIO_IMAGE=docker.io/kuronekoserver/yumunio:latest
# Optional alternative after the GHCR package has been made public:
# YUMUNIO_IMAGE=ghcr.io/kuronekoserver/yumunio:latest
